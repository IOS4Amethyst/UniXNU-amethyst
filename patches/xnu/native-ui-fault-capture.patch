+static bool
+ui_fault_slot(_Atomic unsigned int *count, unsigned int *slot)
+{
+	unsigned int n = atomic_load_explicit(count, memory_order_relaxed);
+	while (n < 8) {
+		if (atomic_compare_exchange_weak_explicit(count, &n, n + 1,
+		    memory_order_relaxed, memory_order_relaxed)) {
+			*slot = n;
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+ui_fault_capture(const char *stage, exception_type_t type,
+    mach_exception_data_t code, mach_msg_type_number_t count, bool reboot)
+{
+	static _Atomic unsigned int faults, reboots;
+	if (!ui_fault_diag) {
+		return;
+	}
+	task_t task = current_task();
+	thread_t thread = current_thread();
+	struct proc *p = get_bsdtask_info(task);
+	if (p == NULL) {
+		return;
+	}
+	int pid = proc_pid(p);
+	const char *name = proc_best_name(p);
+	if (reboot ? pid != 1 :
+	    (strcmp(name, "SpringBoard") && strcmp(name, "backboardd") &&
+	    strcmp(name, "watchdogd") && strcmp(name, "liveactivitiesd") &&
+	    strcmp(name, "devicerecoverytool") && strcmp(name, "configd") && pid != 1)) {
+		return;
+	}
+	unsigned int slot;
+	if (!ui_fault_slot(reboot ? &reboots : &faults, &slot)) {
+		return;
+	}
+	ui_fault_log("ui-fault: %s #%u pid=%d tid=%llu name=%.32s type=0x%x count=%u code=0x%llx subcode=0x%llx\n",
+	    stage, slot, pid, (unsigned long long)thread_tid(thread), name, type, count,
+	    count > 0 ? (unsigned long long)code[0] : 0ULL,
+	    count > 1 ? (unsigned long long)code[1] : 0ULL);
+	arm_saved_state_t *ss = find_user_regs(thread);
+	if (ss == NULL || !is_saved_state64(ss)) {
+		ui_fault_log("ui-fault: %s #%u no-arm64-user-state\n", stage, slot);
+		return;
+	}
+	ui_fault_log("ui-fault: %s #%u pc=0x%llx lr=0x%llx sp=0x%llx fp=0x%llx esr=0x%x far=0x%llx\n",
+	    stage, slot, get_saved_state_pc(ss), get_saved_state_lr(ss),
+	    get_saved_state_sp(ss), get_saved_state_fp(ss),
+	    get_saved_state_esr(ss), get_saved_state_far(ss));
+	for (unsigned int i = 0; i < 8; i += 4) {
+		ui_fault_log("ui-fault: %s #%u x%u..%u=0x%llx 0x%llx 0x%llx 0x%llx\n",
+		    stage, slot, i, i + 3, get_saved_state_reg(ss, i),
+		    get_saved_state_reg(ss, i + 1), get_saved_state_reg(ss, i + 2),
+		    get_saved_state_reg(ss, i + 3));
+	}
+	/* Native telemetry snapshot, not guessed procargs/dyld-private offsets.
+	 * UUID may still be unset during dyld startup; not an atomic cache identity. */
+	ui_fault_log("ui-fault: %s #%u main=0x%llx cache-slide=0x%x (ffffffff=unknown) cache-uuid=%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x\n",
+	    stage, slot, (unsigned long long)task->mach_header_vm_address,
+	    task->task_shared_region_slide,
+	    task->task_shared_region_uuid[0], task->task_shared_region_uuid[1],
+	    task->task_shared_region_uuid[2], task->task_shared_region_uuid[3],
+	    task->task_shared_region_uuid[4], task->task_shared_region_uuid[5],
+	    task->task_shared_region_uuid[6], task->task_shared_region_uuid[7],
+	    task->task_shared_region_uuid[8], task->task_shared_region_uuid[9],
+	    task->task_shared_region_uuid[10], task->task_shared_region_uuid[11],
+	    task->task_shared_region_uuid[12], task->task_shared_region_uuid[13],
+	    task->task_shared_region_uuid[14], task->task_shared_region_uuid[15]);
+	/* Current-task, pre-delivery process context; no exception lock held.
+	 * ESR/FAR on reboot are saved state, NOT a new exception. */
