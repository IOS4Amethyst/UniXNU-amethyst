+		if (fp == 0 || (fp & 15) || fp > UINT64_MAX - 16) {
+			ui_fault_log("ui-fault: %s #%u frame-stop=%u fp=0x%llx\n",
+			    stage, slot, i, (unsigned long long)fp);
+			break;
+		}
