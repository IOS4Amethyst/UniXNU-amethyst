+static int
+unixnu_d94_spawnattr(user_addr_t attrp, struct _posix_spawnattr *psa, uint8_t *sanitizer)
+{
+	uint8_t raw[0xc8];
+	uint32_t security;
+	int error = copyin(attrp, raw, sizeof(raw));
+	if (error != 0) {
+		return error;
+	}
+	memcpy(&security, raw + 0xac, sizeof(security));
+	if (security & ~0x00001f01U) {
+		return EINVAL;
+	}
+	/* ponytail: reject all valid security requests until effects/auth are ported.
+	 * Darwin26 bits are NOT the same enum as native uint16_t psa_sec_flags. */
+	if (security != 0) {
+		return ENOTSUP;
+	}
+	bzero(psa, offsetof(struct _posix_spawnattr, psa_ports));
+	/* Copy through launch_type, not its padding or native security field. */
+	memcpy(psa, raw, offsetof(struct _posix_spawnattr, psa_launch_type) + sizeof(psa->psa_launch_type));
+	memcpy(&psa->psa_crash_count, raw + 0xb4, sizeof(psa->psa_crash_count));
+	memcpy(&psa->psa_throttle_timeout, raw + 0xb8, sizeof(psa->psa_throttle_timeout));
+	memcpy(&psa->psa_kqworkloop_soft_limit, raw + 0xbc, sizeof(psa->psa_kqworkloop_soft_limit));
+	memcpy(&psa->psa_kqworkloop_hard_limit, raw + 0xc0, sizeof(psa->psa_kqworkloop_hard_limit));
+	memcpy(&psa->psa_conclave_mem_limit, raw + 0xc4, sizeof(psa->psa_conclave_mem_limit));
+	*sanitizer = raw[0xb0] & 0x0e;
+	return 0;
+}
