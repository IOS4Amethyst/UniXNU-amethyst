diff --git a/NativeAdrenoSubmit.h b/NativeAdrenoSubmit.h
index 2134cec..572c6e5 100644
--- a/NativeAdrenoSubmit.h
+++ b/NativeAdrenoSubmit.h
@@ -133,7 +133,7 @@ public:
     /* msm's recover_worker: the job on the hung fence is the guilty one (its VM is marked, NativeAdrenoVm::noteHang), the ring fence
      * moves past it, restart resets the GPU, the guilty job is retired, then every later job is submitted again with its own fence
      * (a job of an unusable VM without its buffers). Callers serialize this with every other method. A failed restart poisons. */
-    IOReturn recover(NativeAdrenoRestart restart,void *cookie,const NativeAdrenoRingClock *,NativeAdrenoRecovery *,const uint32_t *contextFault=nullptr);
+    IOReturn recover(NativeAdrenoRestart restart,void *cookie,const NativeAdrenoRingClock *,NativeAdrenoRecovery *,const uint32_t *contextFault=nullptr,bool retryHung=true);
     bool poisoned() const {return poisoned_;}
     size_t outstanding() const;
     NativeAdrenoSubmitStats stats() const {return stats_;}
