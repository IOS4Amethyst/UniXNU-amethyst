diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 5e28090..04e47cb 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -9398,3 +9398,32 @@ OSMetaClassDefineReservedUnused(IOService, 44);
 OSMetaClassDefineReservedUnused(IOService, 45);
 OSMetaClassDefineReservedUnused(IOService, 46);
 OSMetaClassDefineReservedUnused(IOService, 47);
+
+/*
+ * D94 bring-up shim. The iOS 27 donor kernelcache (fa07057b) has an IOService
+ * DriverKit RPC stub at 0xfffffff00b2ab224 (message ID 0xbf66f4287c60ef85;
+ * arguments OSObject *, bool, OSObject *, OUT OSDictionary **, supermethod)
+ * that xnu-12377 lacks; com.apple.driver.AppleARMPlatform imports it. Answer as
+ * a kernel whose IOService dispatch does not know the message: clear the output
+ * and return kIOReturnUnsupported. Not hardware qualified.
+ */
+static uint64_t unixnu_d94_ioservice_rpc_bf66_calls;
+
+extern "C" IOReturn unixnu_d94_ioservice_rpc_bf66(IOService *service, OSObject *arg1, bool arg2,
+    OSObject *arg3, OSDictionary **result, void *supermethod);
+
+extern "C" __attribute__((used, noinline)) IOReturn
+unixnu_d94_ioservice_rpc_bf66(IOService *service, OSObject *arg1, bool arg2,
+    OSObject *arg3, OSDictionary **result, void *supermethod)
+{
+	(void)service;
+	(void)arg1;
+	(void)arg2;
+	(void)arg3;
+	(void)supermethod;
+	__atomic_fetch_add(&unixnu_d94_ioservice_rpc_bf66_calls, 1, __ATOMIC_RELAXED);
+	if (result != NULL) {
+		*result = NULL;
+	}
+	return kIOReturnUnsupported;
+}
