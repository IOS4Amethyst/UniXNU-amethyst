diff --git a/bsd/kern/kern_codesigning.c b/bsd/kern/kern_codesigning.c
index 2671137..eb7d827 100644
--- a/bsd/kern/kern_codesigning.c
+++ b/bsd/kern/kern_codesigning.c
@@ -1671,3 +1671,67 @@ kernel_image4_monitor_trap(
 
 	return _kernel_image4_monitor_trap(selector, input_data, input_size);
 }
+
+/*
+ * D94 bring-up shims. The iOS 27 donor kernelcache (fa07057b) has four Image4
+ * secure-channel monitor helpers after kernel_image4_monitor_trap that
+ * xnu-12377 lacks; com.apple.security.Image4 imports them (donor
+ * 0xfffffff00b11beac, bf24, bf90, bfb0). The donor forwards each request to a
+ * co-processor mailbox and returns the reply value, 0xffff when no valid reply
+ * arrives, or 3 for NULL arguments. This hardware has no such monitor, so every
+ * call reports the donor's no-reply result. Not hardware qualified.
+ */
+static uint64_t unixnu_d94_image4_unavailable_calls[4];
+
+extern uint32_t unixnu_d94_image4_unavail_beac(uint64_t arg0, uint64_t arg1, uint64_t arg2);
+extern uint32_t unixnu_d94_image4_unavail_bf24(uint64_t arg0);
+extern uint32_t unixnu_d94_image4_unavail_bf90(const void *arg0, const void *arg1,
+    const void *arg2, const void *arg3);
+extern uint32_t unixnu_d94_image4_unavail_bfb0(const void *arg0, const void *arg1);
+
+/* Donor 0xfffffff00b11beac: monitor query, selector 0x34. */
+__attribute__((used, noinline))
+uint32_t
+unixnu_d94_image4_unavail_beac(uint64_t arg0, uint64_t arg1, uint64_t arg2)
+{
+	(void)arg0;
+	(void)arg1;
+	(void)arg2;
+	__atomic_fetch_add(&unixnu_d94_image4_unavailable_calls[0], 1, __ATOMIC_RELAXED);
+	return 0xffff;
+}
+
+/* Donor 0xfffffff00b11bf24: monitor query, selector 0x35. */
+__attribute__((used, noinline))
+uint32_t
+unixnu_d94_image4_unavail_bf24(uint64_t arg0)
+{
+	(void)arg0;
+	__atomic_fetch_add(&unixnu_d94_image4_unavailable_calls[1], 1, __ATOMIC_RELAXED);
+	return 0xffff;
+}
+
+/* Donor 0xfffffff00b11bf90: four-pointer request, 3 when any pointer is NULL. */
+__attribute__((used, noinline))
+uint32_t
+unixnu_d94_image4_unavail_bf90(const void *arg0, const void *arg1,
+    const void *arg2, const void *arg3)
+{
+	if (arg0 == NULL || arg1 == NULL || arg2 == NULL || arg3 == NULL) {
+		return 3;
+	}
+	__atomic_fetch_add(&unixnu_d94_image4_unavailable_calls[2], 1, __ATOMIC_RELAXED);
+	return 0xffff;
+}
+
+/* Donor 0xfffffff00b11bfb0: two-pointer request (selector 0x37), 3 when either is NULL. */
+__attribute__((used, noinline))
+uint32_t
+unixnu_d94_image4_unavail_bfb0(const void *arg0, const void *arg1)
+{
+	if (arg0 == NULL || arg1 == NULL) {
+		return 3;
+	}
+	__atomic_fetch_add(&unixnu_d94_image4_unavailable_calls[3], 1, __ATOMIC_RELAXED);
+	return 0xffff;
+}
