+		int error = copyin((user_addr_t)fp, frame, sizeof(frame));
+		if (error != 0) {
+			ui_fault_log("ui-fault: %s #%u frame=%u copyin=%d fp=0x%llx\n",
+			    stage, slot, i, error, (unsigned long long)fp);
+			break;
+		}
+		ui_fault_log("ui-fault: %s #%u frame=%u fp=0x%llx next=0x%llx lr-raw=0x%llx\n",
+		    stage, slot, i, (unsigned long long)fp,
+		    (unsigned long long)frame[0], (unsigned long long)frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+}
